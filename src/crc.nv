// CRC — cyclic redundancy checks, table driven, four algorithms.
//
// What it is.  A CRC is the remainder of the message, read as one very
// long binary polynomial, divided by a fixed generator polynomial.  It
// costs a table lookup and an xor per byte and catches every burst of
// errors shorter than its width, which is why every lossy link — a
// UART, a radio, a disk sector — carries one.
//
// What it does.  Four named algorithms, each fully specified so that a
// value computed here is the value every other implementation computes:
//
//   CRC-16/CCITT-FALSE   poly 0x1021, init 0xffff, no reflection
//   CRC-16/MODBUS        poly 0x8005 reflected, init 0xffff
//   CRC-32               poly 0x04c11db7 reflected, the one in zlib,
//                        PNG, ZIP and Ethernet
//   CRC-32C              poly 0x1edc6f41 reflected, the Castagnoli
//                        polynomial used by iSCSI, ext4 and SCTP
//
// "CCITT-FALSE" is the name the catalogue of CRC algorithms gives the
// variant that is widely called "CRC-16-CCITT" and is not the one CCITT
// specified.  It is used rather than corrected here because it is the
// name a reader will be holding when they come looking.
//
// How to use it.  Build the algorithm once — it computes a 256-entry
// table — and keep it; then either take a checksum in one call
// (`checksum`, `verify`) or feed the running state one chunk at a time
// (`start`, `update`, `finish`).  Each of those carries a worked
// example below, and each constructor carries its published check
// value.
//
// What it costs.  One table lookup, one xor and one shift per byte, and
// no allocation at all while checksumming — the state is an `Int`.  The
// table is 256 entries built once per `Crc` value; building one per
// message would cost more than the message.  The step function is
// arithmetic on `Int` and needs no heap, so a target without one can
// carry the table as a constant and use the same step.

use std.bytes
use std.list

// How many entries a byte-wise CRC table has: one per possible input
// byte.
fn table_size() -> Int
    256

// A fully specified CRC algorithm: the generator's table, the state to
// start from, the value to xor into the result, and the width in bits.
//
// Build one with a constructor — `crc32()` and the three others — and
// hold on to it: the table is computed once per value, and building one
// per message would cost more than the message.  A `Crc` carries no
// running state, so one value serves every message and every thread.
//
// `reflected` says which end of each byte enters the division first.  A
// reflected algorithm feeds the least significant bit first and shifts
// its state right; a non-reflected one feeds the most significant bit
// first and shifts left.  The two produce different numbers from the
// same polynomial, which is why every CRC has to name both.
pub struct Crc
    table: [Int]
    initial: Int
    xor_out: Int
    width: Int
    reflected: Bool

// The mask that keeps a value inside `width` bits.
fn width_mask(width: Int) -> Int
    // Both intermediates are named because the shifts bind LOOSER than
    // `-` (SPEC §6 levels 11 and 12), so the one-line form would read
    // as though it shifted by 64 and then subtracted.
    let all_ones = 0 - 1
    let unused_bits = 64 - width
    all_ones >>> unused_bits

// The table for a reflected algorithm: the remainder of each byte fed
// least significant bit first, with the polynomial already reversed.
fn reflected_table(poly_reversed: Int) -> [Int]
    var out: [Int] = []
    for byte in 0 .. table_size()
        var remainder = byte
        for _bit in 0 .. 8
            if (remainder & 1) == 1
                remainder = (remainder >>> 1) ^ poly_reversed
            else
                remainder >>>= 1
        out = list.push(out, remainder)
    out

// The table for a non-reflected algorithm: the remainder of each byte
// fed most significant bit first, aligned to the top of the width.
fn msb_table(poly: Int, width: Int) -> [Int]
    let top_bit = width - 1
    let byte_shift = width - 8
    let top = 1 << top_bit
    let mask = width_mask(width)
    var out: [Int] = []
    for byte in 0 .. table_size()
        var remainder = byte << byte_shift
        for _bit in 0 .. 8
            if (remainder & top) != 0
                remainder = ((remainder << 1) ^ poly) & mask
            else
                remainder = (remainder << 1) & mask
        out = list.push(out, remainder)
    out

// Build CRC-16/CCITT-FALSE — poly 0x1021, init 0xffff, no reflection,
// no final xor.
//
// The 16-bit variant most protocols mean when they say "CRC-16-CCITT",
// which is not the algorithm CCITT specified; the catalogue's name for
// it is kept here because it is the name a reader arrives holding.  Its
// published check value — the result over the nine bytes `123456789`,
// which every catalogue quotes — is 0x29b1.  A value that disagrees
// with another implementation's is almost always the wrong variant
// rather than a wrong implementation, and this is the number that says
// which.
//
// ```novo
// use std.bytes
//
// println("${crc.crc16_ccitt_false().checksum(bytes.from_str("123456789"))}")
// // 10673, which is 0x29b1 — the published check value
// ```
pub fn crc16_ccitt_false() -> Crc
    Crc { table: msb_table(0x1021, 16), initial: 0xffff, xor_out: 0,
          width: 16, reflected: false }

// Build CRC-16/MODBUS — poly 0x8005 reflected, init 0xffff, no final
// xor.
//
// The frame check of the Modbus RTU serial protocol.  Published check
// value over `123456789`: 0x4b37.  Note that Modbus sends the two bytes
// low byte first, which is the framing's business and not this
// function's — what you get here is the number.
//
// ```novo
// use std.bytes
//
// println("${crc.crc16_modbus().checksum(bytes.from_str("123456789"))}")
// // 19255, which is 0x4b37 — the published check value
// ```
pub fn crc16_modbus() -> Crc
    Crc { table: reflected_table(0xa001), initial: 0xffff, xor_out: 0,
          width: 16, reflected: true }

// Build CRC-32 — the IEEE 802.3 polynomial, reflected, init and final
// xor all ones.
//
// The one in zlib, gzip, PNG, ZIP and Ethernet, and the algorithm to
// reach for when a format says only "CRC-32".  Published check value
// over `123456789`: 0xcbf43926.  Over an empty message it is 0, because
// the initial state and the final xor are both all ones and cancel.
//
// ```novo
// use std.bytes
//
// let algo = crc.crc32()
// println("${algo.checksum(bytes.from_str("123456789"))}")
// // 3421780262, which is 0xcbf43926 — the published check value
// println("${algo.checksum(bytes.zeros(0))}")   // 0, for an empty message
// ```
pub fn crc32() -> Crc
    Crc { table: reflected_table(0xedb88320), initial: 0xffffffff,
          xor_out: 0xffffffff, width: 32, reflected: true }

// Build CRC-32C — the Castagnoli polynomial, reflected, init and final
// xor all ones.
//
// Used by iSCSI, SCTP, ext4 and Btrfs, and the one modern processors
// have an instruction for — an instruction this package does not reach
// for, so the cost here is the table on every target.  Published check
// value over `123456789`: 0xe3069283.
//
// ```novo
// use std.bytes
//
// println("${crc.crc32c().checksum(bytes.from_str("123456789"))}")
// // 3808858755, which is 0xe3069283 — the published check value
// ```
pub fn crc32c() -> Crc
    Crc { table: reflected_table(0x82f63b78), initial: 0xffffffff,
          xor_out: 0xffffffff, width: 32, reflected: true }

impl Crc
    // Answer the state a fresh message starts from.
    //
    // The first half of the streaming form; `update` folds bytes into
    // what this returns and `finish` turns the result into a check
    // value.  It is not itself a check value — the final xor has not
    // been applied — so nothing should compare against it.
    fn start(self) -> Int
        self.initial

    // Fold one byte into a running state, and answer the new state.
    //
    // This is the whole algorithm: the low or high byte of the state
    // selects a table entry, and the rest of the state shifts into it.
    // It takes and returns an `Int` and touches no buffer, so it is the
    // function a target without a heap uses directly — and the one a
    // receiver uses when the bytes come off a UART as they arrive.
    //
    // ```novo
    // use std.bytes
    //
    // // A byte at a time reaches the same answer as one call, which is
    // // the property the streaming form exists for.
    // let algo = crc.crc32()
    // let msg = bytes.from_str("123456789")
    // var state = algo.start()
    // for i in 0 .. bytes.len(msg)
    //     state = algo.step(state, bytes.byte_at(msg, i) ?? 0)
    // println("${algo.finish(state) == algo.checksum(msg)}")   // true
    // ```
    fn step(self, state: Int, byte: Int) -> Int
        if self.reflected
            let index = (state ^ byte) & 0xff
            self.table[index] ^ (state >>> 8)
        else
            // `>>>` and not `>>`: the state is a bit pattern, and an
            // arithmetic shift would smear a sign it does not have.
            // The count is named because the shifts bind looser than
            // `-`, so `state >>> self.width - 8` is right and reads
            // wrong.
            let byte_shift = self.width - 8
            let top_byte = state >>> byte_shift
            let index = (top_byte ^ byte) & 0xff
            (self.table[index] ^ (state << 8)) & width_mask(self.width)

    // Fold every byte of `src` into a running state.  Reads the caller's
    // buffer and allocates nothing.
    //
    // The streaming form: a message that arrives in pieces must produce
    // the byte-for-byte same check as one that arrived whole, so the
    // state is passed through rather than kept, and the final xor waits
    // for `finish`.
    //
    // ```novo
    // use std.bytes
    //
    // // A header and a body, checked as one message.
    // let algo = crc.crc32()
    // let msg = bytes.from_str("123456789")
    // var state = algo.start()
    // state = algo.update(state, bytes.slice(msg, 0, 4))
    // state = algo.update(state, bytes.slice(msg, 4, 9))
    // println("${algo.finish(state)}")   // 3421780262, the whole-message answer
    // ```
    fn update(self, state: Int, src: Bytes) -> Int
        self.update_range(state, src, 0, bytes.len(src))

    // Fold `count` bytes of `src` from `off` into a running state.
    //
    // The form for a frame whose header and trailer are not covered by
    // the check, so that no slice has to be cut to leave them out.  The
    // range is trusted: bytes outside the buffer read as 0 rather than
    // panicking, because a frame length is input and input never
    // decides whether a program lives.
    fn update_range(self, state: Int, src: Bytes, off: Int, count: Int) -> Int
        var running = state
        for i in off .. off + count
            running = self.step(running, bytes.byte_at(src, i) ?? 0)
        running

    // Answer the check value a running state has reached.
    //
    // Separate from `update` because the final xor must be applied once,
    // at the end: applying it twice would undo it, which is what a
    // `finish` inside the loop would do.
    fn finish(self, state: Int) -> Int
        (state ^ self.xor_out) & width_mask(self.width)

    // Answer the check value of a whole buffer, in one call.
    //
    // `start`, `update` and `finish` in the order they go, for the
    // caller that has all the bytes at once.  Allocates nothing.
    //
    // ```novo
    // use std.bytes
    //
    // println("${crc.crc32().checksum(bytes.from_str("hello"))}")   // 907060870
    //
    // // A single flipped bit is a different number — which is the
    // // whole reason to send one.
    // println("${crc.crc32().checksum(bytes.from_str("hemlo"))}")   // 936561841
    // ```
    fn checksum(self, src: Bytes) -> Int
        self.finish(self.update(self.start(), src))

    // Answer whether `src` carries the check value `expected` — the
    // question a receiver actually asks, worded so it reads as one.
    //
    // It is `checksum(src) == expected` and nothing more: there is no
    // constant-time comparison here, because a CRC is an error check
    // and not a signature.  It detects accidental corruption and does
    // nothing at all against a change someone made on purpose.
    //
    // ```novo
    // use std.bytes
    //
    // let algo = crc.crc32()
    // println("${algo.verify(bytes.from_str("123456789"), 0xcbf43926)}")   // true
    // println("${algo.verify(bytes.from_str("12345678x"), 0xcbf43926)}")   // false
    // ```
    fn verify(self, src: Bytes, expected: Int) -> Bool
        self.checksum(src) == expected
