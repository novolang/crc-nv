// crc.nv — cyclic redundancy checks, table driven, four algorithms.
//
// A cyclic redundancy check is the remainder left when the message,
// read as one long binary polynomial, is divided by a fixed generator
// polynomial.  It costs one table lookup and one exclusive-or per byte.
// It detects every burst of errors shorter than its own width, which is
// why a lossy link carries one.  A UART, a radio and a disk sector are
// three such links.
//
// A CRC algorithm is named by four parameters, and two programs agree
// on a number only when all four agree.  The polynomial is the divisor.
// The initial state is the value the remainder starts from.  Reflection
// says which end of each byte enters the division first.  The final xor
// is the value exclusive-ored into the remainder once the last byte is
// in.  The four algorithms here are these:
//
//   CRC-16/CCITT-FALSE   poly 0x1021, init 0xffff, no reflection
//   CRC-16/MODBUS        poly 0x8005 reflected, init 0xffff
//   CRC-32               poly 0x04c11db7 reflected, the one in zlib,
//                        PNG, ZIP and Ethernet
//   CRC-32C              poly 0x1edc6f41 reflected, the Castagnoli
//                        polynomial used by iSCSI, ext4 and SCTP
//
// "CCITT-FALSE" is the name the catalogue of parametrised CRC
// algorithms gives the variant that is widely called "CRC-16-CCITT" and
// is not the one CCITT specified.  The catalogue's name is used rather
// than corrected, because it is the name a reader will be holding when
// they come looking.
//
// A caller builds the algorithm once and keeps the value, because a
// constructor computes a 256-entry table.  Then it either takes a
// checksum in one call, with `checksum` or `verify`, or feeds the
// running state one chunk at a time, with `start`, `update` and
// `finish`.  Each of those carries a worked example below.  Each
// constructor carries its algorithm's published check value, which is
// the result over the nine ASCII bytes `123456789`.
//
// Checksumming costs one table lookup, one exclusive-or and one shift
// per byte, and it allocates nothing, because the running state is an
// `Int`.  The table is built once per `Crc` value.  Building one per
// message would cost more than the message.
//
// A `Crc` holds its table as a list and its one-call forms take
// `Bytes`, so it needs a heap.  A program with none, such as a
// microcontroller's firmware, has CRC-32C as three functions over an
// `Int` state, `crc32c_start`, `crc32c_step` and `crc32c_finish`, whose
// table is code rather than memory.

use std.bytes
use std.list

// How many entries a byte-wise CRC table has.  There is one per
// possible input byte.
@tier(app)
fn table_size() -> Int
    256

// A fully specified CRC algorithm.  It holds the generator's table, the
// state to start from, the value to exclusive-or into the result, and
// the width in bits.
//
// A constructor builds one.  `crc32()` and the three others are the
// four.  Hold on to what a constructor answers, because the table is
// computed once per value and building one per message would cost more
// than the message.  A `Crc` carries no running state, so one value
// serves every message and every thread.
//
// `reflected` says which end of each byte enters the division first.  A
// reflected algorithm feeds the least significant bit first and shifts
// its state right.  A non-reflected one feeds the most significant bit
// first and shifts left.  The two answer different numbers from the
// same polynomial, which is why every CRC algorithm names both.
pub struct Crc
    table: [Int]
    initial: Int
    xor_out: Int
    width: Int
    reflected: Bool

// The mask that keeps a value inside `width` bits.
@tier(app)
fn width_mask(width: Int) -> Int
    // Both intermediates are named because the shifts bind looser than
    // `-` (SPEC § 6 levels 11 and 12).  The one-line form would read as
    // though it shifted by 64 and then subtracted.
    let all_ones = 0 - 1
    let unused_bits = 64 - width
    all_ones >>> unused_bits

// The table for a reflected algorithm.  Each entry is the remainder of
// one byte fed least significant bit first.  The polynomial arrives
// already reversed.
@tier(app)
fn reflected_table(poly_reversed: Int) -> [Int]
    var out: [Int] = []
    for byte in 0..table_size()
        var remainder = byte
        for _bit in 0..8
            if (remainder & 1) == 1
                remainder = (remainder >>> 1) ^ poly_reversed
            else
                remainder >>>= 1
        out = list.push(out, remainder)
    out

// The table for a non-reflected algorithm.  Each entry is the remainder
// of one byte fed most significant bit first, aligned to the top of the
// width.
@tier(app)
fn msb_table(poly: Int, width: Int) -> [Int]
    let top_bit = width - 1
    let byte_shift = width - 8
    let top = 1 << top_bit
    let mask = width_mask(width)
    var out: [Int] = []
    for byte in 0..table_size()
        var remainder = byte << byte_shift
        for _bit in 0..8
            if (remainder & top) != 0
                remainder = ((remainder << 1) ^ poly) & mask
            else
                remainder = (remainder << 1) & mask
        out = list.push(out, remainder)
    out

// Build CRC-16/CCITT-FALSE.  Its parameters are poly 0x1021, init
// 0xffff, no reflection and no final xor.
//
// This is the 16-bit variant most protocols mean when they say
// "CRC-16-CCITT".  It is not the algorithm CCITT specified.  The
// catalogue's name for it is kept here, because it is the name a reader
// arrives holding.  Its published check value is 0x29b1, which is its
// result over the nine bytes `123456789`.  A value that disagrees with
// another program's is almost always the wrong variant rather than a
// wrong implementation, and the check value is the number that says
// which variant each side is running.
//
// ```novo
// use std.bytes
//
// println("${crc.crc16_ccitt_false().checksum(bytes.from_str("123456789"))}")
// // 10673, or 0x29b1, the published check value
// ```
pub @tier(app)
fn crc16_ccitt_false() -> Crc
    Crc { table: msb_table(0x1021, 16), initial: 0xffff, xor_out: 0,
          width: 16, reflected: false }

// Build CRC-16/MODBUS.  Its parameters are poly 0x8005 reflected, init
// 0xffff and no final xor.
//
// This is the frame check of the Modbus RTU serial protocol.  Its
// published check value over `123456789` is 0x4b37.  Modbus RTU sends
// the two check bytes low byte first.  That is the framing's business
// rather than this function's, which answers the number.
//
// ```novo
// use std.bytes
//
// println("${crc.crc16_modbus().checksum(bytes.from_str("123456789"))}")
// // 19255, or 0x4b37, the published check value
// ```
pub @tier(app)
fn crc16_modbus() -> Crc
    Crc { table: reflected_table(0xa001), initial: 0xffff, xor_out: 0,
          width: 16, reflected: true }

// Build CRC-32.  Its parameters are the IEEE 802.3 polynomial,
// reflected, with the initial state and the final xor both all ones.
//
// This is the algorithm in zlib, gzip, PNG, ZIP and Ethernet, and the
// one to reach for when a format says only "CRC-32".  Its published
// check value over `123456789` is 0xcbf43926.  Over an empty message it
// answers 0, because the initial state and the final xor are both all
// ones and cancel.
//
// ```novo
// use std.bytes
//
// let algo = crc.crc32()
// println("${algo.checksum(bytes.from_str("123456789"))}")
// // 3421780262, or 0xcbf43926, the published check value
// println("${algo.checksum(bytes.zeros(0))}")   // 0, for an empty message
// ```
pub @tier(app)
fn crc32() -> Crc
    Crc { table: reflected_table(0xedb88320), initial: 0xffffffff,
          xor_out: 0xffffffff, width: 32, reflected: true }

// Build CRC-32C.  Its parameters are the Castagnoli polynomial,
// reflected, with the initial state and the final xor both all ones.
//
// This is the algorithm used by iSCSI, SCTP, ext4 and Btrfs, and RFC
// 3309 is where SCTP specifies it.  Its published check value over
// `123456789` is 0xe3069283.  A processor instruction computes it on
// x86-64 and on AArch64.  This package does not reach for that
// instruction, so the cost here is the table on every target.
//
// ```novo
// use std.bytes
//
// println("${crc.crc32c().checksum(bytes.from_str("123456789"))}")
// // 3808858755, or 0xe3069283, the published check value
// ```
pub @tier(app)
fn crc32c() -> Crc
    Crc { table: reflected_table(0x82f63b78), initial: 0xffffffff,
          xor_out: 0xffffffff, width: 32, reflected: true }

// The CRC-32C register after four zero bits are shifted through a
// register that holds `i` in its low four bits.  These are the 16
// entries of the table that the four-bits-at-a-time form reads.  They
// are a `match` rather than a list, so a device keeps them in its code
// and builds nothing at start-up.
@tier(embedded)
fn crc32c_nibble(i: Int) -> Int
    match i
        0  => 0x00000000
        1  => 0x105ec76f
        2  => 0x20bd8ede
        3  => 0x30e349b1
        4  => 0x417b1dbc
        5  => 0x5125dad3
        6  => 0x61c69362
        7  => 0x7198540d
        8  => 0x82f63b78
        9  => 0x92a8fc17
        10 => 0xa24bb5a6
        11 => 0xb21572c9
        12 => 0xc38d26c4
        13 => 0xd3d3e1ab
        14 => 0xe330a81a
        _  => 0xf36e6f75

// Answer the state a CRC-32C message starts from, 0xffffffff.
//
// This and the two functions after it are CRC-32C for a program with
// no heap allocator, such as a microcontroller's firmware.  They hold
// no table in memory and take one byte at a time, so the bytes can come
// from flash, from a peripheral or from a fixed-size buffer.  They
// answer what `crc32c().checksum` answers over the same bytes.
//
// ```novo
// // The published check value: the bytes of "123456789" are 49 to 57.
// var state = crc.crc32c_start()
// for i in 0 .. 9
//     state = crc.crc32c_step(state, 49 + i)
// println("${crc.crc32c_finish(state)}")   // 3808858755, or 0xe3069283
// ```
pub @tier(embedded)
fn crc32c_start() -> Int
    0xffffffff

// Fold one byte, the low eight bits of `byte`, into a CRC-32C state,
// and answer the new state.
//
// It reads the 16-entry table twice per byte, four bits at a time,
// where the bitwise definition takes eight steps.  Every value stays
// within 32 bits.  The answer is not a check value until `crc32c_finish`
// applies the final xor.
//
// ```novo
// // One byte, 0x31 or "1", folded into a fresh state.
// println("${crc.crc32c_finish(crc.crc32c_step(crc.crc32c_start(), 0x31))}")
// // 2432014819, or 0x90f599e3
// ```
pub @tier(embedded)
fn crc32c_step(state: Int, byte: Int) -> Int
    let c = state ^ (byte & 0xff)
    let d = (c >>> 4) ^ crc32c_nibble(c & 0xf)
    (d >>> 4) ^ crc32c_nibble(d & 0xf)

// Answer the CRC-32C check value a running state has reached.  It
// applies the final xor, 0xffffffff, once.
//
// ```novo
// // No bytes at all: the initial state and the final xor cancel.
// println("${crc.crc32c_finish(crc.crc32c_start())}")   // 0
// ```
pub @tier(embedded)
fn crc32c_finish(state: Int) -> Int
    (state ^ 0xffffffff) & 0xffffffff

impl Crc
    // Answer the state a fresh message starts from.
    //
    // This is where the streaming form begins.  `update` folds bytes
    // into what this answers, and `finish` turns the result into a
    // check value.  What it answers is not itself a check value,
    // because the final xor has not been applied, so nothing should
    // compare against it.
    @tier(app)
    fn start(self) -> Int
        self.initial

    // Fold one byte into a running state, and answer the new state.
    //
    // This is the whole algorithm.  The low or the high byte of the
    // state selects a table entry, and the rest of the state shifts
    // into it.  It takes an `Int` and answers an `Int`, and it reads no
    // buffer.  A target with no heap allocator therefore calls it
    // directly, and so does a receiver taking the bytes off a UART as
    // they arrive.
    //
    // ```novo
    // use std.bytes
    //
    // // A byte at a time reaches the same answer as one call.  That is
    // // the property the streaming form exists for.
    // let algo = crc.crc32()
    // let msg = bytes.from_str("123456789")
    // var state = algo.start()
    // for i in 0 .. bytes.len(msg)
    //     state = algo.step(state, bytes.byte_at(msg, i) ?? 0)
    // println("${algo.finish(state) == algo.checksum(msg)}")   // true
    // ```
    @tier(app)
    fn step(self, state: Int, byte: Int) -> Int
        if self.reflected
            let index = (state ^ byte) & 0xff
            self.table[index] ^ (state >>> 8)
        else
            // The shift is `>>>` and not `>>`, because the state is a
            // bit pattern and an arithmetic shift would smear a sign it
            // does not have.  The count is named because the shifts
            // bind looser than `-`, so `state >>> self.width - 8` is
            // correct and reads wrong.
            let byte_shift = self.width - 8
            let top_byte = state >>> byte_shift
            let index = (top_byte ^ byte) & 0xff
            (self.table[index] ^ (state << 8)) & width_mask(self.width)

    // Fold every byte of `src` into a running state, and answer the new
    // state.  It reads the caller's buffer and allocates nothing.
    //
    // This is the streaming form.  A message that arrives in pieces
    // must produce the byte-for-byte same check as one that arrived
    // whole.  The state is therefore passed through rather than kept,
    // and the final xor waits for `finish`.
    //
    // ```novo
    // use std.bytes
    //
    // // A header and a body, checked as one message.
    // let algo = crc.crc32()
    // let msg = bytes.from_str("123456789")
    // var state = algo.start()
    // state = algo.update(state, bytes.slice(msg, 0, 4))
    // state = algo.update(state, bytes.slice(msg, 4, 9))
    // println("${algo.finish(state)}")   // 3421780262, the whole-message answer
    // ```
    @tier(app)
    fn update(self, state: Int, src: Bytes) -> Int
        self.update_range(state, src, 0, bytes.len(src))

    // Fold `count` bytes of `src`, starting at `off`, into a running
    // state, and answer the new state.
    //
    // This is the form for a frame whose header and trailer are not
    // covered by the check.  No slice has to be cut to leave them out.
    // The range is trusted.  A byte outside the buffer reads as 0
    // rather than stopping the program, because a frame length is
    // input.
    //
    // ```novo
    // use std.bytes
    //
    // // A frame whose first and last byte are outside the check.
    // let algo = crc.crc32()
    // let framed = bytes.from_str("!123456789?")
    // println("${algo.finish(algo.update_range(algo.start(), framed, 1, 9))}")
    // // 3421780262, the check value of the nine bytes between them
    // ```
    @tier(app)
    fn update_range(self, state: Int, src: Bytes, off: Int, count: Int) -> Int
        var running = state
        for i in off..off + count
            running = self.step(running, bytes.byte_at(src, i) ?? 0)
        running

    // Answer the check value a running state has reached.
    //
    // It is separate from `update` because the final xor must be
    // applied once, at the end.  Applying it twice undoes it, which is
    // what a `finish` inside the loop would do.
    @tier(app)
    fn finish(self, state: Int) -> Int
        (state ^ self.xor_out) & width_mask(self.width)

    // Answer the check value of a whole buffer, in one call.
    //
    // It is `start`, `update` and `finish` in the order they go, for
    // the caller that holds all the bytes at once.  It allocates
    // nothing.
    //
    // ```novo
    // use std.bytes
    //
    // println("${crc.crc32().checksum(bytes.from_str("hello"))}")   // 907060870
    //
    // // A single flipped bit answers a different number, which is the
    // // reason to send one.
    // println("${crc.crc32().checksum(bytes.from_str("hemlo"))}")   // 936561841
    // ```
    @tier(app)
    fn checksum(self, src: Bytes) -> Int
        self.finish(self.update(self.start(), src))

    // Answer whether `src` carries the check value `expected`.  This is
    // the question a receiver asks.
    //
    // It is `checksum(src) == expected` and nothing more.  There is no
    // constant-time comparison here, because a CRC is an error check
    // and not a signature.  It detects accidental corruption.  It does
    // nothing at all against a change someone made on purpose.
    //
    // ```novo
    // use std.bytes
    //
    // let algo = crc.crc32()
    // println("${algo.verify(bytes.from_str("123456789"), 0xcbf43926)}")   // true
    // println("${algo.verify(bytes.from_str("12345678x"), 0xcbf43926)}")   // false
    // ```
    @tier(app)
    fn verify(self, src: Bytes, expected: Int) -> Bool
        self.checksum(src) == expected
